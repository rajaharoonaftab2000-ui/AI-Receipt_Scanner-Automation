      "id": "8953aa98-cdd7-4eef-b347-ca9ae2fa8d00",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=Your-API-Key",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [\n      { \"text\": \"This is a photo of a receipt. Read it and extract the following details. Respond ONLY in this exact format:\\nStore: <store/shop name>\\nDate: <date on receipt, or 'not specified'>\\nAmount: <total amount as a number only, no currency symbol>\\nCategory: <one word category like Grocery, Food, Fuel, Shopping, Utilities, or Other>\" },\n      { \"inline_data\": { \"mime_type\": \"image/jpeg\", \"data\": \"{{ $json.imageBase64 }}\" } }\n    ]\n  }]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "id": "6587a2f5-3e48-4bea-abb1-1658c5643842",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.candidates[0].content.parts[0].text;\n\nconst store = text.match(/Store:\\s*(.+)/)?.[1]?.trim() || 'Unknown';\nconst date = text.match(/Date:\\s*(.+)/)?.[1]?.trim() || 'not specified';\nconst amount = text.match(/Amount:\\s*([\\d.]+)/)?.[1]?.trim() || '0';\nconst category = text.match(/Category:\\s*(.+)/)?.[1]?.trim() || 'Other';\n\nreturn {\n  json: {\n    chatId: $('Code in JavaScript').item.json.chatId,\n    store,\n    date,\n    amount,\n    category\n  }\n};"
      },
