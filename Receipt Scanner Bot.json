    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = binaryData.toString('base64');\n\nreturn {\n  json: {\n    chatId: $('Telegram Trigger').item.json.message.chat.id,\n    imageBase64: base64\n  }\n};"
      },
